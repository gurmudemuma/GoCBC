#!/bin/bash
set -euo pipefail
# Peer invokes: bin/release BUILD_OUTPUT_DIR RELEASE_OUTPUT_DIR (two args)
# $1 = build output dir, $2 = release output dir
# The old script used $2/$3, so $3 was unbound and release always failed.
BUILD_OUTPUT_DIR=$1
RELEASE_OUTPUT_DIR=$2
cp "$BUILD_OUTPUT_DIR/connection.json" "$RELEASE_OUTPUT_DIR/connection.json"
exit 0
