# ============================================================
# GoCBC BLOCKCHAIN CONFIGURATION
# ============================================================
# Add these settings to your .env file
# ============================================================

# ==================== HYPERLEDGER FABRIC CONFIGURATION ====================

# Enable Fabric blockchain integration
FABRIC_ENABLED=true

# Require Fabric on startup (fail if unavailable)
# Set to false for graceful degradation during development
FABRIC_REQUIRED=false

# Require user-specific identities (false for development with admin)
FABRIC_REQUIRE_USER_IDENTITIES=false

# Minimum orderer consenters (1 for Solo, 3 for Raft production)
FABRIC_MIN_ORDERER_CONSENTERS=1

# Use localhost for Fabric peers
# Set to false when API is running inside Docker network
FABRIC_AS_LOCALHOST=false

# Fabric wallet path (where identities are stored)
FABRIC_WALLET_PATH=./wallet

# Fabric channel name
FABRIC_CHANNEL_NAME=coffeechannel

# Fabric chaincode name
FABRIC_CHAINCODE_NAME=coffee

# Default MSP ID (ECTA is the default)
FABRIC_MSP_ID=ECTAMSP

# Transaction timeout (milliseconds)
FABRIC_COMMIT_TIMEOUT=120000

# ==================== PEER ENDPOINTS ====================
# All peers in the consortium network
# Format: grpcs://hostname:port

# ECTA Peer (Port 7051)
FABRIC_PEER_URL_ECTA=grpcs://peer0.ecta.cecbs.et:7051
FABRIC_PEER_TLS_CA_ECTA=../blockchain/organizations/peerOrganizations/ecta.cecbs.et/peers/peer0.ecta.cecbs.et/tls/ca.crt

# ECX Peer (Port 8051)
FABRIC_PEER_URL_ECX=grpcs://peer0.ecx.cecbs.et:8051
FABRIC_PEER_TLS_CA_ECX=../blockchain/organizations/peerOrganizations/ecx.cecbs.et/peers/peer0.ecx.cecbs.et/tls/ca.crt

# Banks Peer (Port 9051)
FABRIC_PEER_URL_BANKS=grpcs://peer0.banks.cecbs.et:9051
FABRIC_PEER_TLS_CA_BANKS=../blockchain/organizations/peerOrganizations/banks.cecbs.et/peers/peer0.banks.cecbs.et/tls/ca.crt

# NBE Peer (Port 10051)
FABRIC_PEER_URL_NBE=grpcs://peer0.nbe.cecbs.et:10051
FABRIC_PEER_TLS_CA_NBE=../blockchain/organizations/peerOrganizations/nbe.cecbs.et/peers/peer0.nbe.cecbs.et/tls/ca.crt

# Customs Peer (Port 11051)
FABRIC_PEER_URL_CUSTOMS=grpcs://peer0.customs.cecbs.et:11051
FABRIC_PEER_TLS_CA_CUSTOMS=../blockchain/organizations/peerOrganizations/customs.cecbs.et/peers/peer0.customs.cecbs.et/tls/ca.crt

# Shipping Peer (Port 12051)
FABRIC_PEER_URL_SHIPPING=grpcs://peer0.shipping.cecbs.et:12051
FABRIC_PEER_TLS_CA_SHIPPING=../blockchain/organizations/peerOrganizations/shipping.cecbs.et/peers/peer0.shipping.cecbs.et/tls/ca.crt

# ==================== ORDERER ENDPOINT ====================

# Primary Orderer (Port 7050)
FABRIC_ORDERER_1_URL=grpcs://orderer.cecbs.et:7050
FABRIC_ORDERER_1_TLS_CA_PATH=../blockchain/organizations/ordererOrganizations/cecbs.et/orderers/orderer.cecbs.et/msp/tlscacerts/tlsca.cecbs.et-cert.pem
FABRIC_ORDERER_1_SERVER_NAME=orderer.cecbs.et

# Additional orderers (for Raft consensus - future use)
# FABRIC_ORDERER_2_URL=grpcs://orderer2.cecbs.et:7051
# FABRIC_ORDERER_2_TLS_CA_PATH=../blockchain/organizations/ordererOrganizations/cecbs.et/orderers/orderer2.cecbs.et/msp/tlscacerts/tlsca.cecbs.et-cert.pem
# FABRIC_ORDERER_2_SERVER_NAME=orderer2.cecbs.et

# ==================== COUCHDB CONFIGURATION ====================
# Direct CouchDB access for blockchain state queries (optional, for performance)

# ECTA CouchDB (exposed on host port 5985)
COUCHDB_URL=http://couchdb.ecta:5984
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=adminpw
FABRIC_CHANNEL=coffeechannel
FABRIC_CHAINCODE=coffee

# ==================== ORGANIZATION MAPPING ====================
# Maps portal organizations to blockchain MSP IDs
# Used automatically by fabricService.ts

# ECTA (Ethiopian Coffee & Tea Authority)
# MSP: ECTAMSP

# ECX (Ethiopian Commodity Exchange)
# MSP: ECXMSP

# NBE (National Bank of Ethiopia)
# MSP: NBEMSP

# Banks (Commercial Banks)
# MSP: BanksMSP

# Customs (Ethiopian Customs)
# MSP: CustomsMSP

# Shipping (Shipping Lines)
# MSP: ShippingMSP

# ==================== NOTES ====================
#
# 1. TLS Configuration:
#    - All peer and orderer connections use TLS (grpcs://)
#    - CA certificates are required for each endpoint
#    - Chaincode connection uses NO TLS (configured in docker-compose)
#
# 2. Network Connectivity:
#    - API container must be on the same Docker network: cecbs-network
#    - Or use host networking with FABRIC_AS_LOCALHOST=true
#
# 3. Admin Identities:
#    - Admin identities are auto-imported from cryptogen certificates
#    - Location: ../blockchain/organizations/peerOrganizations/{org}/users/Admin@{org}.cecbs.et/msp/
#
# 4. User Identities:
#    - For production, each user should have a CA-issued identity
#    - Set FABRIC_REQUIRE_USER_IDENTITIES=true in production
#
# 5. Performance:
#    - Connection pooling is handled by Gateway
#    - Discovery service finds available peers automatically
#    - Endorsement policy requires signatures from consortium MSPs
#
# ============================================================
