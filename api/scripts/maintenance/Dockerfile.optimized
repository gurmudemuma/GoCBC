# Ethiopian Coffee Export Consortium Blockchain System (CECBS)
# API Gateway Dockerfile - Optimized for Slow Networks

FROM node:20-alpine AS builder

# Install build dependencies for native modules (bcrypt, etc.)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    gcc \
    musl-dev

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies using cache mount (BuildKit feature)
# This persists npm cache across builds
RUN --mount=type=cache,target=/root/.npm \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-timeout 300000 && \
    npm install --no-audit --no-fund --prefer-offline

# Copy source code
COPY src ./src
COPY scripts ./scripts

# Build TypeScript
RUN npm run build

# Prune dev dependencies
RUN npm prune --omit=dev --no-audit --no-fund

# Production stage
FROM node:20-alpine

# Install tini for proper signal handling
RUN apk add --no-cache tini

# Set working directory
WORKDIR /app

# Copy package files and the pruned production dependencies from the builder.
COPY package*.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules

# Copy built application from builder
COPY --from=builder --chown=node:node /app/dist ./dist

# Create necessary directories
RUN mkdir -p logs uploads wallet fabric-certs crypto-keys certificates licenses \
    && chown -R node:node /app

# Switch to non-root user
USER node

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start application with tini
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
