# ============================================================
# CECBS API Server - Production Environment Configuration
# Domain: coffeex.cbe.com.et (Server: 10.3.15.7)
# ============================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production on production server
# 2. Generate secure secrets (see commands at bottom)
# 3. Choose HTTP or HTTPS configuration based on your setup
# 4. Never commit .env.production to git
# 5. All Fabric URLs, CA names, affiliations, and certificate paths below are
#    examples. Replace them with values and trust bundles supplied by each
#    consortium operator; this file is not deployable as checked in.
#
# ============================================================

# ==================== SERVER CONFIGURATION ====================

# Environment mode
NODE_ENV=production

# Server port (localhost only, nginx proxies externally)
PORT=3001

# ==================== API URLs ====================

# OPTION 1: Production HTTP (via IP)
# API_BASE_URL=http://10.3.15.7/api/v1

# OPTION 2: Production HTTPS (via domain - RECOMMENDED)
API_BASE_URL=https://coffeex.cbe.com.et/api/v1

# ==================== CORS CONFIGURATION ====================

# OPTION 1: HTTP origins
# ALLOWED_ORIGINS=http://10.3.15.7

# OPTION 2: HTTPS origins (RECOMMENDED)
ALLOWED_ORIGINS=https://coffeex.cbe.com.et

# ==================== JWT CONFIGURATION ====================

# JWT secret key for token signing
# IMPORTANT: Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_SECRET_32_CHARS

# JWT expiry time
JWT_EXPIRY=24h

# Refresh token expiry
REFRESH_TOKEN_EXPIRY=7d

# ==================== SESSION SECURITY ====================

# Session secret
# IMPORTANT: Generate with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_SECURE_SECRET_32_CHARS

# BCrypt rounds for password hashing
BCRYPT_ROUNDS=12

# ==================== HYPERLEDGER FABRIC CONFIGURATION ====================

# Enable Fabric blockchain integration
FABRIC_ENABLED=true

# Require Fabric on startup
FABRIC_REQUIRED=true
FABRIC_REQUIRE_USER_IDENTITIES=true
FABRIC_MIN_ORDERER_CONSENTERS=3

# Resolve the consortium's advertised peer endpoints, not localhost remapping.
FABRIC_AS_LOCALHOST=false

# Reachable peer endpoints and matching TLS CA certificates, provisioned by each org.
FABRIC_PEER_URL_ECTA=grpcs://peer0.ecta.cecbs.et:7051
FABRIC_PEER_TLS_CA_ECTA=/etc/cecbs/fabric-tls/ecta-peer-ca.pem
FABRIC_PEER_URL_ECX=grpcs://peer0.ecx.cecbs.et:8051
FABRIC_PEER_TLS_CA_ECX=/etc/cecbs/fabric-tls/ecx-peer-ca.pem
FABRIC_PEER_URL_BANKS=grpcs://peer0.banks.cecbs.et:9051
FABRIC_PEER_TLS_CA_BANKS=/etc/cecbs/fabric-tls/banks-peer-ca.pem
FABRIC_PEER_URL_NBE=grpcs://peer0.nbe.cecbs.et:10051
FABRIC_PEER_TLS_CA_NBE=/etc/cecbs/fabric-tls/nbe-peer-ca.pem
FABRIC_PEER_URL_CUSTOMS=grpcs://peer0.customs.cecbs.et:11051
FABRIC_PEER_TLS_CA_CUSTOMS=/etc/cecbs/fabric-tls/customs-peer-ca.pem
FABRIC_PEER_URL_SHIPPING=grpcs://peer0.shipping.cecbs.et:12051
FABRIC_PEER_TLS_CA_SHIPPING=/etc/cecbs/fabric-tls/shipping-peer-ca.pem

# Enrollment CA roots used to verify transaction creator/endorser certificates;
# these must match the channel MSP trust roots (they are not peer TLS roots).
FABRIC_MSP_CA_ROOT_ECTA=/etc/cecbs/fabric-msp/ecta-ca-root.pem
FABRIC_MSP_CA_ROOT_ECX=/etc/cecbs/fabric-msp/ecx-ca-root.pem
FABRIC_MSP_CA_ROOT_BANKS=/etc/cecbs/fabric-msp/banks-ca-root.pem
FABRIC_MSP_CA_ROOT_NBE=/etc/cecbs/fabric-msp/nbe-ca-root.pem
FABRIC_MSP_CA_ROOT_CUSTOMS=/etc/cecbs/fabric-msp/customs-ca-root.pem
FABRIC_MSP_CA_ROOT_SHIPPING=/etc/cecbs/fabric-msp/shipping-ca-root.pem
# Optional intermediate CA bundles, when organization certificates use one.
# FABRIC_MSP_CA_INTERMEDIATE_ECTA=/etc/cecbs/fabric-msp/ecta-intermediates.pem
# FABRIC_MSP_CA_INTERMEDIATE_ECX=/etc/cecbs/fabric-msp/ecx-intermediates.pem
# FABRIC_MSP_CA_INTERMEDIATE_BANKS=/etc/cecbs/fabric-msp/banks-intermediates.pem
# FABRIC_MSP_CA_INTERMEDIATE_NBE=/etc/cecbs/fabric-msp/nbe-intermediates.pem
# FABRIC_MSP_CA_INTERMEDIATE_CUSTOMS=/etc/cecbs/fabric-msp/customs-intermediates.pem
# FABRIC_MSP_CA_INTERMEDIATE_SHIPPING=/etc/cecbs/fabric-msp/shipping-intermediates.pem
# Replace with at least three independently operated orderers in the committed
# channel Raft consenter set. Each endpoint uses its own address and TLS root.
FABRIC_ORDERER_1_URL=grpcs://orderer0.ecta.cecbs.et:7050
FABRIC_ORDERER_1_TLS_CA_PATH=/etc/cecbs/fabric-tls/orderer-ecta-ca.pem
FABRIC_ORDERER_1_OPERATOR=ECTA
FABRIC_ORDERER_2_URL=grpcs://orderer0.ecx.cecbs.et:7050
FABRIC_ORDERER_2_TLS_CA_PATH=/etc/cecbs/fabric-tls/orderer-ecx-ca.pem
FABRIC_ORDERER_2_OPERATOR=ECX
FABRIC_ORDERER_3_URL=grpcs://orderer0.nbe.cecbs.et:7050
FABRIC_ORDERER_3_TLS_CA_PATH=/etc/cecbs/fabric-tls/orderer-nbe-ca.pem
FABRIC_ORDERER_3_OPERATOR=NBE

# Organization CA endpoints, TLS roots, CA names, and the registrar affiliation
# must be supplied by each operator. The admin-<MSP> wallet identity must be
# enrolled with that CA and have permission to register client identities with
# userID/role/organization/email attributes (hf.Registrar.Attributes must allow
# those attributes). Revocation also needs hf.Revoker and hf.GenCRL authority.
FABRIC_CA_URL_ECTA=https://ca.ecta.cecbs.et:7054
FABRIC_CA_NAME_ECTA=ca-ecta
FABRIC_CA_TLS_CA_ECTA=/etc/cecbs/fabric-tls/ca-ecta-root.pem
FABRIC_CA_AFFILIATION_ECTA=org1.department1
FABRIC_CA_URL_ECX=https://ca.ecx.cecbs.et:8054
FABRIC_CA_NAME_ECX=ca-ecx
FABRIC_CA_TLS_CA_ECX=/etc/cecbs/fabric-tls/ca-ecx-root.pem
FABRIC_CA_AFFILIATION_ECX=org1.department1
FABRIC_CA_URL_BANKS=https://ca.banks.cecbs.et:9054
FABRIC_CA_NAME_BANKS=ca-banks
FABRIC_CA_TLS_CA_BANKS=/etc/cecbs/fabric-tls/ca-banks-root.pem
FABRIC_CA_AFFILIATION_BANKS=org1.department1
FABRIC_CA_URL_NBE=https://ca.nbe.cecbs.et:10054
FABRIC_CA_NAME_NBE=ca-nbe
FABRIC_CA_TLS_CA_NBE=/etc/cecbs/fabric-tls/ca-nbe-root.pem
FABRIC_CA_AFFILIATION_NBE=org1.department1
FABRIC_CA_URL_CUSTOMS=https://ca.customs.cecbs.et:11054
FABRIC_CA_NAME_CUSTOMS=ca-customs
FABRIC_CA_TLS_CA_CUSTOMS=/etc/cecbs/fabric-tls/ca-customs-root.pem
FABRIC_CA_AFFILIATION_CUSTOMS=org1.department1
FABRIC_CA_URL_SHIPPING=https://ca.shipping.cecbs.et:12054
FABRIC_CA_NAME_SHIPPING=ca-shipping
FABRIC_CA_TLS_CA_SHIPPING=/etc/cecbs/fabric-tls/ca-shipping-root.pem
FABRIC_CA_AFFILIATION_SHIPPING=org1.department1

# Fabric configuration paths
FABRIC_WALLET_PATH=/var/lib/cecbs/fabric-wallet
# The API's initial health/readiness connection uses admin-ECTAMSP. Provision
# that identity through ECTA governance before startup. Enrollment/revocation
# also requires admin-<MSP_ID> registrar identities for each participating CA,
# each with only the registrar permissions that its organization authorizes.
# Each authenticated user needs a CA-issued X.509 identity stored in this
# wallet as user-<MSP_ID>-<database-user-id> (for example user-ECTAMSP-42).
# Missing identities fail production requests; the API never substitutes admin.
FABRIC_CCP_PATH=../blockchain/organizations/peerOrganizations/ecta.cecbs.et/connection-ecta.json
FABRIC_CHANNEL_NAME=coffeechannel
FABRIC_CHAINCODE_NAME=coffee
FABRIC_MSP_ID=ECTAMSP
# Never copy admin private keys into individual user identities. Fabric CA
# revocation also requires the owning organization to commit the updated MSP CRL
# in a channel configuration update before peers reject revoked certificates.

# ==================== DATABASE CONFIGURATION ====================

# Use PostgreSQL in production (recommended)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cecbs_production
DB_USER=cecbs_user
DB_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD

# Fallback to SQLite (not recommended for production)
# DATABASE_PATH=./cecbs.db

# ==================== LOGGING CONFIGURATION ====================

# Production log level
LOG_LEVEL=warn

# Log directory
LOG_DIR=./logs

# Log rotation (days)
LOG_MAX_FILES=60

# Log max size (MB)
LOG_MAX_SIZE=50

# ==================== FILE UPLOAD CONFIGURATION ====================

# Upload directory
UPLOAD_DIR=./uploads

# Maximum file size (bytes) - 50MB
MAX_FILE_SIZE=52428800

# Allowed file types
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,zip

# ==================== WEBSOCKET CONFIGURATION ====================

# WebSocket server port
WS_PORT=3002

# Enable WebSocket server
ENABLE_WEBSOCKET=true

# ==================== RATE LIMITING ====================

# Rate limit window (milliseconds) - 15 minutes
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (stricter in production)
RATE_LIMIT_MAX_REQUESTS=500

# Blockchain-specific rate limit
BLOCKCHAIN_RATE_LIMIT_MAX=50

# ==================== SECURITY ====================

# Enable helmet security headers
ENABLE_HELMET=true

# Force HTTPS redirect (enable after SSL setup)
FORCE_HTTPS=true

# ==================== FEATURE FLAGS ====================

# Disable Swagger in production
ENABLE_SWAGGER=false

# Enable production features
ENABLE_WEBSOCKET=true
ENABLE_FILE_UPLOAD=true
ENABLE_BLOCKCHAIN_EXPLORER=false
ENABLE_METRICS=true

# ==================== IPFS CONFIGURATION ====================

# Use IPFS for document storage
USE_IPFS=true

# IPFS connection
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# OPTION 1: IPFS Gateway via IP
# IPFS_GATEWAY=http://10.3.15.7/ipfs/

# OPTION 2: IPFS Gateway via domain (RECOMMENDED)
IPFS_GATEWAY=https://coffeex.cbe.com.et/ipfs/

# Document encryption key (64 characters hex string)
# IMPORTANT: Generate with: openssl rand -hex 32
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# ==================== EXTERNAL SERVICES ====================

# SMTP relay for approval, rejection, and system notifications.
# Production startup rejects blank credentials and template placeholders.
# For Gmail, enable 2-Step Verification and enter a generated App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=coffeeexportconsortium@gmail.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=coffeeexportconsortium@gmail.com

# ==================== REDIS CONFIGURATION ====================

# Redis for session storage and caching (recommended for production)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DB=0

# ==================== MONITORING ====================

# Enable metrics endpoint
ENABLE_METRICS=true

# Metrics port (internal only)
METRICS_PORT=9090

# Health check endpoint
HEALTH_CHECK_ENABLED=true

# ==================== BACKUP CONFIGURATION ====================

# Auto backup enabled
AUTO_BACKUP_ENABLED=true

# Backup directory
BACKUP_DIR=./backups

# Backup schedule (cron expression) - Daily at 3 AM
BACKUP_SCHEDULE=0 3 * * *

# ==================== INTERNATIONALIZATION ====================

# Default language
DEFAULT_LOCALE=en

# Supported languages
SUPPORTED_LOCALES=en,am

# Timezone
TIMEZONE=Africa/Addis_Ababa

# ============================================================
# SECURITY CHECKLIST - GENERATE THESE SECRETS!
# ============================================================
#
# 1. Generate JWT Secret:
#    openssl rand -base64 32
#
# 2. Generate Session Secret:
#    openssl rand -base64 32
#
# 3. Generate Document Encryption Key:
#    openssl rand -hex 32
#
# 4. Create database user and password:
#    sudo -u postgres createuser cecbs_user
#    sudo -u postgres createdb cecbs_production -O cecbs_user
#    sudo -u postgres psql -c "ALTER USER cecbs_user PASSWORD 'SECURE_PASSWORD';"
#
# 5. Setup Redis password:
#    redis-cli config set requirepass SECURE_REDIS_PASSWORD
#
# ============================================================
# QUICK DEPLOYMENT COMMANDS
# ============================================================
#
# 1. Copy to production server:
#    scp .env.production.example root@10.3.15.7:/opt/cecbs/api/.env.production
#
# 2. Edit secrets on server:
#    nano /opt/cecbs/api/.env.production
#
# 3. Start production server:
#    cd /opt/cecbs/api && npm start
#
# ============================================================
