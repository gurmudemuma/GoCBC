{
  "name": "cecbs-network",
  "version": "1.0.0",
  "description": "Ethiopian Coffee Export Consortium Blockchain System (CECBS) - Connection Profile for ECTA Organization",
  "client": {
    "organization": "ECTA",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "organizations": {
    "ECTA": {
      "mspid": "ECTAMSP",
      "peers": [
        "peer0.ecta.cecbs.et"
      ],
      "certificateAuthorities": [
        "ca.ecta.cecbs.et"
      ]
    },
    "ECX": {
      "mspid": "ECXMSP",
      "peers": [
        "peer0.ecx.cecbs.et"
      ]
    },
    "Banks": {
      "mspid": "BanksMSP",
      "peers": [
        "peer0.banks.cecbs.et"
      ]
    },
    "NBE": {
      "mspid": "NBEMSP",
      "peers": [
        "peer0.nbe.cecbs.et"
      ]
    },
    "Customs": {
      "mspid": "CustomsMSP",
      "peers": [
        "peer0.customs.cecbs.et"
      ]
    },
    "Shipping": {
      "mspid": "ShippingMSP",
      "peers": [
        "peer0.shipping.cecbs.et"
      ]
    }
  },
  "orderers": {
    "orderer.cecbs.et": {
      "url": "grpcs://orderer.cecbs.et:7050",
      "tlsCACerts": {
        "path": "organizations/ordererOrganizations/cecbs.et/orderers/orderer.cecbs.et/msp/tlscacerts/tlsca.cecbs.et-cert.pem"
      },
      "grpcOptions": {
