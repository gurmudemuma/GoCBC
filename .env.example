# ==================== REDIS CONFIGURATION ====================

# Redis password (required by docker-compose-fabric.yml)
# Generate with: openssl rand -base64 32
# IMPORTANT: Change this value - do not use the example below
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
