api/logs/
ui/logs/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Blockchain env files carry live credentials — never commit them.
# (api/.env.blockchain and api/.env.blockchain.fixed were tracked before
# this rule and were untracked with `git rm --cached` (files kept on disk).
# They are loaded from disk as env_file by docker-compose-fabric.yml, so
# untracking them does not change runtime behaviour — but the secrets in
# them were once committed, so they must still be rotated. See the
# rotation procedure in the secrets-hygiene handoff. On the Docker host,
# back up both files OUTSIDE the repo BEFORE pulling this change: git
# will delete the clean tracked copies on pull; restore them afterwards.)
api/.env.blockchain
api/.env.blockchain.fixed

# Local SQLite databases — legacy test artefacts, no code reads them
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Docker volumes
data/
postgres-data/

# Blockchain artifacts
wallet/
**/wallet/
*.id

# Cache
.cache/
.turbo/
.webpack/

# Misc
.vercel
.eslintcache
.stylelintcache

# Hyperledger Fabric binaries (root-level download dirs only — a bare
# `config/` pattern also swallowed ui/src/config/, which is why the
# frontend config modules were never committed)
/bin/
/config/

# Logs
logs/**/*.log
*.log

# Test outputs
tests/**/*.log
test-output*.txt

# Backups
*-backup-*/
*.bak

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/


# TypeScript incremental build info
ui/tsconfig.tsbuildinfo

# Runtime upload/license/storage dirs — read from disk by the
# document/license download routes; never commit their contents.
# (Untracked with `git rm --cached`; files stay on disk so downloads keep
# working. Same pull hazard as api/.env.blockchain above: on the Docker
# host, back up these dirs OUTSIDE the repo BEFORE pulling this change —
# git will delete the clean tracked copies on pull; restore them after.)
api/uploads/
api/licenses/
api/storage/
