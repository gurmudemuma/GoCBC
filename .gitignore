# Build artifacts
*.tar.gz
*.tar

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
.next/
**/.next/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
**/logs/
api/logs/
ui/logs/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Blockchain env files carry live credentials — never commit them.
# (api/.env.blockchain and api/.env.blockchain.fixed are already tracked
# from before this rule; they are referenced as env_file by
# docker-compose-fabric.yml, so removing them needs a coordinated
# deployment change. Rotate their secrets.)
api/.env.blockchain
api/.env.blockchain.fixed

# Local SQLite databases — legacy test artefacts, no code reads them
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Docker volumes
data/
postgres-data/

# Blockchain artifacts
wallet/
**/wallet/
*.id

# Cache
.cache/
.turbo/
.webpack/

# Misc
.vercel
.eslintcache
.stylelintcache

# Hyperledger Fabric binaries (root-level download dirs only — a bare
# `config/` pattern also swallowed ui/src/config/, which is why the
# frontend config modules were never committed)
/bin/
/config/

# Logs
logs/**/*.log
*.log

# Test outputs
tests/**/*.log
test-output*.txt

# Backups
*-backup-*/
*.bak

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/


# TypeScript incremental build info
ui/tsconfig.tsbuildinfo
